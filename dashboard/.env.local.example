# Copy to .env.local and adjust if the Fastify backend runs somewhere other
# than the default localhost:3000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000/ws

# Server-only (no NEXT_PUBLIC_ prefix — never sent to the browser). Used by
# app/api/approvals/[id]/route.ts to call the backend's approval-decision
# endpoint on the operator's behalf. Only needed if the backend has
# AUTOOPS_API_KEY set (autoops_ai/.env) — must match that exact value, or
# Approve/Reject in the dashboard will fail with 401. Leave unset if the
# backend doesn't set AUTOOPS_API_KEY either.
AUTOOPS_API_KEY=
AUTOOPS_BACKEND_URL=http://localhost:3000
